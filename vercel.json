{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "build": {
    "env": {
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
    }
  },
  "installCommand": "test -f mineral-classifier-app/frontend/package.json || (echo 'ABORT: Vercel Root Directory must be EMPTY (the repo root)' && exit 1) && npm --prefix mineral-classifier-app/frontend install",
  "buildCommand": "npm --prefix mineral-classifier-app/frontend run build && npm --prefix mineral-classifier-app/frontend run verify:dist",
  "outputDirectory": "mineral-classifier-app/frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index?route=" },
    { "source": "/api/(.*)", "destination": "/api/index?route=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
