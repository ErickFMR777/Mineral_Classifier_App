# Most rules live in the repo-root .gitignore. This file only covers paths
# specific to the application subtree.

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.env

# Build
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Training intermediates written by train_classifier.py and
# scripts/extract-features.mjs. Large, regenerable, and not needed to deploy.
*.pt
*.pth
*.pkl
*.npy

# The shipped model artefacts are JSON under frontend/public/models/ and are
# deliberately tracked — see the note in the root .gitignore. The former
# `!models/mineral_classes.json` exception is gone along with the duplicate it
# protected; the canonical class list now lives only in the repo-root data/.

# Database (nothing in this project uses one)
*.db

# Temp
tmp/
temp/
